# PostgreSQL connection string (Supabase or Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign and verify JWTs (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Python statistical validation service
# Local: run validation-service/app.py → http://localhost:5000
# Production: Render URL e.g. https://pos-validation-service.onrender.com
VALIDATION_SERVICE_URL=http://localhost:5000
